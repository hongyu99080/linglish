# Sync role: cn or global (used only for logging)
SYNC_ROLE=cn

# PostgreSQL connection strings
LOCAL_DB_URL=postgres://user:pass@127.0.0.1:5432/linglish
REMOTE_DB_URL=postgres://user:pass@remote-host:5432/linglish

# Tables list file (one table per line)
SYNC_TABLES_FILE=app/backend/scripts/sync/db-tables.example.txt

# State directory for last-sync timestamps
SYNC_STATE_DIR=app/backend/scripts/sync/.sync-state

# Backward skew in seconds to avoid missing near-boundary updates
SYNC_SKEW_SEC=5

# Rclone config for media sync (bidirectional)
# Project media directory (videos/recordings/thumbnails/audio)
RCLONE_SRC=/root/linglish/app/backend/public
RCLONE_DST=remote:/root/linglish/app/backend/public
# Set to true only on the first bisync run
RCLONE_RESYNC=false
# Extra rclone flags
RCLONE_FLAGS=--fast-list
